{
  "name": "pacs-plate-recognizer",
  "version": "0.1.0",
  "private": true,
  "description": "PACS plates module - S3 -> Rekognition DetectText -> PlateRecognized event. Standalone scaffold.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "offline": "node --import tsx scripts/local-test.ts --offline",
    "live": "node --import tsx scripts/local-test.ts",
    "build": "esbuild src/handler.ts --bundle --minify --sourcemap --platform=node --target=node24 --format=esm --outfile=dist/handler.mjs --external:@aws-sdk/*"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.712.0",
    "@aws-sdk/client-rekognition": "^3.712.0",
    "@aws-sdk/client-s3": "^3.712.0",
    "@aws-sdk/lib-dynamodb": "^3.712.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
